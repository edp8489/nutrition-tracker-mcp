# Remote base URL for full-dataset chunk fetches on Android (ADR-0019).
# Web builds fetch same-origin; Android WebView has no nginx origin, so set
# this to the deployed data path, e.g.:
# VITE_CHUNK_BASE=https://<your-host>/nutrition-tracker/data
VITE_CHUNK_BASE=

# --- MCP server (bun run server; Bun auto-loads .env from the repo root) ---
# Path to the built OpenNutrition SQLite DB (bun run build:sqlite output).
# Default: server/data/opennutrition.sqlite
NUTRITION_DB_PATH=server/data/opennutrition.sqlite
# Port for the streamable HTTP MCP transport. Default: 3000
NUTRITION_PORT=3000
