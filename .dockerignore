# Keep the build context small: external/ (dataset TSV, 269MB) and server/data
# (SQLite DB, 407MB, plus runtime-mounted recipes/ and generated metrics/)
# are excluded — they are gitignored artifacts, rebuilt inside the image or
# volume-mounted at runtime.

.git
.env
.env.*
!.env.example

node_modules
dist
server/data
server/recipes
external
data

android
docs
.gstack
.DS_Store
*.log
