{
  "name": "nutrition-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:android": "vue-tsc --noEmit && vite build --base=/ && rm -rf dist/data/chunks && npx cap sync android",
    "build:dataset": "bun scripts/build-subset.mjs",
    "build:sqlite": "bun scripts/build-sqlite.mjs",
    "preview": "vite preview",
    "server": "bun run server/src/index.ts",
    "lint": "eslint . --ext .vue,.ts,.js --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,js}\" \"scripts/**/*.{mjs,js}\"",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:shared": "tsc -p shared --noEmit",
    "typecheck:server": "tsc -p server --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@vicons/ionicons5": "^0.13.0",
    "chart.js": "^4.4.0",
    "dexie": "^4.0.8",
    "naive-ui": "^2.45.3",
    "pinia": "^2.2.0",
    "uuid": "^14.0.2",
    "vue": "^3.4.0",
    "vue-chartjs": "^5.3.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@types/node": "^26.3.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.27.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "vue-tsc": "^2.0.0"
  }
}
