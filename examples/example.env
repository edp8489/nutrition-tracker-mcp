# --- MCP server (bun run server; Bun auto-loads .env from the repo root) ---
# Path to the built OpenNutrition SQLite DB (bun run build:sqlite output).
# Default: server/data/opennutrition.sqlite
NUTRITION_DB_PATH=server/data/opennutrition.sqlite
# Server-recipes dir (ADR-0028): one *.json export file per recipe.
# Default: server/data/recipes
NUTRITION_RECIPES_PATH=server/data/recipes
# Port for the streamable HTTP MCP transport. Default: 3000
NUTRITION_PORT=3000

# --- Usage metrics (ADR-0031; opt-in, privacy-preserving aggregates) ---
# Enable request/performance logging: 1 = on, 0 or unset = off (default).
# NUTRITION_ENABLE_LOGGING=1
# Directory for the writable metrics.sqlite store.
# Default: server/data/metrics
# NUTRITION_METRICS_DIR=server/data/metrics
# When set, snapshot lines are also appended to stdout-YYYY-MM-DD.log here
# (one file per local day). Unset = stdout only.
# NUTRITION_METRICS_LOG_DIR=metrics-logs
# Trust the first X-Forwarded-For hop from a reverse proxy you control
# (1 = yes). Default: 0 — use the direct socket address instead. Behind a
# proxy with 0, all clients count as one unique (the proxy itself).
# NUTRITION_TRUST_PROXY=0
# Days to keep raw request rows: -1 or unset = keep forever (default),
# >= 1 = prune after N days at the daily snapshot. 0 is rejected at startup:
# zero retention with logging enabled means "log nothing" — disable logging
# instead.
# NUTRITION_METRICS_RETENTION_DAYS=-1
# UA bucket rules, JSON array of {"match": "...", "bucket": "..."} — first
# substring match wins, replaces the built-in rules (browser/claude-code/
# codex/opencode; fallbacks: other = unmatched, unknown = missing UA).
# NUTRITION_UA_BUCKETS_FILE=/path/to/ua-buckets.json
# Container timezone: snapshot windows and log-file rollover follow the
# local clock (Docker default is UTC). Example: America/New_York
# TZ=America/New_York
